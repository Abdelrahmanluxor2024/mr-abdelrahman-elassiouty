NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Uploads use Vercel Blob. Create a Blob store in Vercel (Storage -> Blob) and
# link it to the project: Vercel injects BLOB_READ_WRITE_TOKEN automatically.
# Firebase Storage is no longer used (it needs the paid Blaze plan since 2026).
# BLOB_READ_WRITE_TOKEN=injected-by-vercel
